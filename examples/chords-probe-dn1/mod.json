{
 "id": "chprobe",
 "version": "0.5",
 "license": "GPL-2.0-or-later",
 "title": "CHORDS live-note probe",
 "category": "Examples",
 "author": "stephen",
 "description": "An arp probe for CHORDS (chords-dn1) on the Digitone mk1: it logs the notes CHORDS hands each trig (S) and each voice started, with its note (V), on the top of CHORDS' page: 6 entries, then it freezes; YES on the page captures the next 6. It changes no sound. For testing only.",
 "device": "digitone-mk1",
 "os": "1.43",
 "sources": [
  "probe.s",
  "probe.c"
 ],
 "subscribe": [
  {
   "event": "ev_render_out",
   "fn": "chprobe_out",
   "order": 50
  },
  {
   "event": "ev_note_queue",
   "fn": "chprobe_queue",
   "order": 50
  },
  {
   "event": "ev_fire_notes",
   "fn": "chprobe_notes",
   "order": 90
  },
  {
   "event": "ev_key",
   "fn": "chprobe_key",
   "order": 40
  },
  {
   "event": "ev_tick",
   "fn": "chprobe_tick",
   "order": 60
  },
  {
   "event": "ev_draw",
   "fn": "chprobe_draw",
   "order": 60
  }
 ],
 "resources": {
  "core": "4.1"
 },
 "requires": [
  "core",
  "seq-events",
  "chords"
 ],
 "ports": {
  "1.44": {}
 }
}
